#!/bin/bash
# SM-T870 Game Mode on the mainline msm DPU and Turnip, running the native
# ARM64 Steam client. Started by tabs7-gamescope-session.service as steamos.
set -eu

prefix=/usr/local/lib/tabs7linux
icd=/usr/share/vulkan/icd.d/freedreno_icd.aarch64.json
export VK_ICD_FILENAMES=$icd VK_DRIVER_FILES=$icd
export LIBSEAT_BACKEND=seatd
export XDG_CURRENT_DESKTOP=gamescope XDG_SESSION_TYPE=wayland
export SDL_VIDEO_MINIMIZE_ON_FOCUS_LOSS=0

steam_env=(
    MESA_LOADER_DRIVER_OVERRIDE=zink GALLIUM_DRIVER=zink
    LIBGL_KOPPER_DISABLE=1
    STEAM_ENABLE_VOLUME_HANDLER=1
)

# The panel is native portrait 1600x2560; "right" is upright landscape
# (verified on hardware; "left" is upside down). Touch mode 4 passes real
# touch events to Steam, as the SteamOS session does; the default (1)
# turns every contact into a left-button drag, so swipes cannot scroll.
exec /usr/bin/gamescope --backend drm --steam \
    --force-orientation right \
    --default-touch-mode 4 --hide-cursor-delay 3000 \
    -- /usr/bin/env "${steam_env[@]}" \
    "$prefix/steamos/steam-client.sh" -gamepadui -steamos3
