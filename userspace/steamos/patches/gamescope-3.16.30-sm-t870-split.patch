+static bool sm_t870_split_requested()
+{
+	static const bool s_bRequested = []()
+	{
+		const char *pszSplit = getenv( "GAMESCOPE_SM_T870_SPLIT" );
+		if ( !pszSplit || !*pszSplit || strcmp( pszSplit, "0" ) == 0 )
+			return false;
+		unsigned long a = 0, b = 0;
+		char cTrailing = 0;
+		if ( sscanf( pszSplit, "%lu,%lu%c", &a, &b, &cTrailing ) != 2 ||
+			 a == 0 || b == 0 || a == b || a > UINT32_MAX || b > UINT32_MAX )
+		{
+			fprintf( stderr, "gamescope: GAMESCOPE_SM_T870_SPLIT requires two distinct plane IDs\n" );
+			abort();
+		}
+		g_SMT870Split.uPlaneIds[0] = uint32_t( a );
+		g_SMT870Split.uPlaneIds[1] = uint32_t( b );
+		return true;
+	}();
+	g_SMT870Split.bRequested = s_bRequested;
+	return s_bRequested;
+}
