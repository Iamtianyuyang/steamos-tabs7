+static int drm_prepare_sm_t870_split( struct drm_t *drm, const struct FrameInfo_t *frameInfo )
+{
+	if ( frameInfo->layers.count() != 1 )
+		return -EINVAL;
+
+	const FrameInfo_t::Layer_t *pLayer = &frameInfo->layers.get( 0 );
+	if ( !pLayer->tex )
+		return -EINVAL;
+	if ( pLayer->tex->width() != k_uSMT870Width || pLayer->tex->height() != k_uSMT870Height )
+	{
+		drm_log.errorf( "SM-T870 split requires a %ux%u composite, got %ux%u",
+			k_uSMT870Width, k_uSMT870Height, pLayer->tex->width(), pLayer->tex->height() );
+		return -EINVAL;
+	}
+
+	gamescope::CDRMFb *pDrmFb = static_cast<gamescope::CDRMFb *>(
+		pLayer->tex->GetBackendFb() ? pLayer->tex->GetBackendFb()->EnsureImported() : nullptr );
+	if ( pDrmFb == nullptr )
+		return -EINVAL;
+
+	const uint32_t uCRTCId = drm->pCRTC->GetObjectId();
+	for ( int i = 0; i < 2; i++ )
+	{
+		gamescope::CDRMPlane *pPlane = g_SMT870Split.pPlanes[i];
+		if ( !( pPlane->GetModePlane()->possible_crtcs & drm->pCRTC->GetCRTCMask() ) )
+			return -EINVAL;
+
+		auto &props = pPlane->GetProperties();
+		const uint64_t ulOffset = uint64_t( k_uSMT870HalfWidth ) * i;
+		props.FB_ID->SetPendingValue( drm->req, pDrmFb->GetFbId(), true );
+		props.CRTC_ID->SetPendingValue( drm->req, uCRTCId, true );
+		props.SRC_X->SetPendingValue( drm->req, ulOffset << 16, true );
+		props.SRC_Y->SetPendingValue( drm->req, 0, true );
+		props.SRC_W->SetPendingValue( drm->req, uint64_t( k_uSMT870HalfWidth ) << 16, true );
+		props.SRC_H->SetPendingValue( drm->req, uint64_t( k_uSMT870Height ) << 16, true );
+		props.CRTC_X->SetPendingValue( drm->req, ulOffset, true );
+		props.CRTC_Y->SetPendingValue( drm->req, 0, true );
+		props.CRTC_W->SetPendingValue( drm->req, k_uSMT870HalfWidth, true );
+		props.CRTC_H->SetPendingValue( drm->req, k_uSMT870Height, true );
+		// Both halves share zpos 0; this is the contract verified on this panel.
+		props.zpos->SetPendingValue( drm->req, 0, true );
+		if ( props.rotation )
+			props.rotation->SetPendingValue( drm->req, DRM_MODE_ROTATE_0, true );
+		if ( props.IN_FENCE_FD )
+			props.IN_FENCE_FD->SetPendingValue( drm->req, -1, true );
+	}
+
+	// Detach every other plane still scanning out on our CRTC (e.g. the primary).
+	for ( std::unique_ptr< gamescope::CDRMPlane > &pPlane : drm->planes )
+	{
+		if ( pPlane.get() == g_SMT870Split.pPlanes[0] || pPlane.get() == g_SMT870Split.pPlanes[1] )
+			continue;
+		if ( pPlane->GetProperties().CRTC_ID->GetCurrentValue() != uCRTCId )
+			continue;
+		pPlane->GetProperties().FB_ID->SetPendingValue( drm->req, 0, true );
+		pPlane->GetProperties().CRTC_ID->SetPendingValue( drm->req, 0, true );
+	}
+
+	drm->m_FbIdsInRequest.emplace_back( pDrmFb );
+	return 0;
+}
