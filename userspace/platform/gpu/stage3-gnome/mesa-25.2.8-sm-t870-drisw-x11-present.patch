+/* Private SM-T870 EGL-X11 experiment: Zink's non-Kopper frontbuffer
+ * callback is a no-op. Read the GPU resource through the standard Gallium
+ * transfer API and use the existing stride-aware SWRAST loader upload.
+ * No Vulkan X11 WSI, DRI3, MIT-SHM, or displaytarget ownership is added.
+ */
+static bool
+drisw_sm_t870_zink_present(struct pipe_context *pipe,
+                           struct dri_drawable *drawable,
+                           struct pipe_resource *ptex)
+{
+   struct pipe_screen *screen = drawable->screen->base.screen;
+   const char *name = screen->get_name(screen);
+   if (!debug_get_bool_option("TABS7_ZINK_X11_PRESENT", false) || !name ||
+       strncmp(name, "zink ", 5) || !strstr(name, "MESA_TURNIP") ||
+       !strstr(name, "Adreno (TM) 650"))
+      return false;
+
+   const __DRIswrastLoaderExtension *loader = drawable->screen->swrast_loader;
+   if (!loader || loader->base.version < 2 || !loader->putImage2 ||
+       ptex->target != PIPE_TEXTURE_2D || ptex->depth0 != 1 ||
+       ptex->array_size != 1 || util_res_sample_count(ptex) != 1 ||
+       !ptex->width0 || !ptex->height0 || ptex->width0 > 8192 || ptex->height0 > 8192 ||
+       (ptex->format != PIPE_FORMAT_B8G8R8A8_UNORM &&
+        ptex->format != PIPE_FORMAT_B8G8R8X8_UNORM &&
+        ptex->format != PIPE_FORMAT_B8G8R8A8_SRGB &&
+        ptex->format != PIPE_FORMAT_B8G8R8X8_SRGB)) {
+      mesa_loge("DRISW: SM-T870 upload guard: loader=%d version=%d putImage2=%d "
+                "target=%u (2D=%u RECT=%u) depth=%u array=%u samples=%u storage_samples=%u "
+                "size=%ux%u format=%s (%u)",
+                loader != NULL, loader ? loader->base.version : -1,
+                loader && loader->putImage2 != NULL,
+                ptex->target, PIPE_TEXTURE_2D, PIPE_TEXTURE_RECT,
+                ptex->depth0, ptex->array_size, ptex->nr_samples, ptex->nr_storage_samples,
+                ptex->width0, ptex->height0, util_format_name(ptex->format), ptex->format);
+      mesa_loge("DRISW: SM-T870 X11 upload requires single-sample BGRA/BGRX 2D texture and putImage2");
+      return true;
+   }
+
+   struct pipe_transfer *transfer = NULL;
+   void *pixels = pipe_texture_map(pipe, ptex, 0, 0, PIPE_MAP_READ,
+                                  0, 0, ptex->width0, ptex->height0, &transfer);
+   if (!pixels || !transfer) {
+      if (transfer)
+         pipe_texture_unmap(pipe, transfer);
+      mesa_loge("DRISW: SM-T870 GPU-to-X11 read transfer failed");
+      return true;
+   }
+   if (debug_get_bool_option("TABS7_ZINK_X11_PRESENT_TRACE", false))
+      mesa_logi("DRISW: explicit SM-T870 GPU-to-X11 putImage2 %ux%u stride=%u format=%u",
+                ptex->width0, ptex->height0, transfer->stride, ptex->format);
+   if (transfer->stride < ptex->width0 * 4) {
+      pipe_texture_unmap(pipe, transfer);
+      mesa_loge("DRISW: SM-T870 GPU-to-X11 transfer stride is too small");
+      return true;
+   }
+
+   /* putImage2 consumes these rows before returning; EGL's X11 loader
+    * copies them into xcb_put_image requests and flushes the connection.
+    * Use actual transfer stride, do not infer linear GPU image storage.
+    * Upload all rows even when the caller supplied damage rectangles.
+    */
+   put_image2(drawable, pixels, 0, 0, ptex->width0, ptex->height0, transfer->stride);
+   pipe_texture_unmap(pipe, transfer);
+   return true;
+}
+
 static inline void
 drisw_present_texture(struct pipe_context *pipe, struct dri_drawable *drawable,
                       struct pipe_resource *ptex, unsigned nrects, struct pipe_box *sub_box)
@@ -194,6 +261,9 @@
    struct dri_screen *screen = drawable->screen;
 
    if (screen->swrast_no_present)
+      return;
+
+   if (drisw_sm_t870_zink_present(pipe, drawable, ptex))
       return;
 
    screen->base.screen->flush_frontbuffer(screen->base.screen, pipe, ptex, 0, 0, drawable, nrects, sub_box);
