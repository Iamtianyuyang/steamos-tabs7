+/* Explicit bridge for the SM-T870: KGSL renders, msm_drm owns scanout.
+ * This does not advertise the DPU as the GPU or alter Vulkan DRM properties.
+ */
+static int
+zink_get_sm_t870_kgsl_device(const struct zink_screen *screen,
+                            uint32_t pdev_count, const VkPhysicalDevice *pdevs)
+{
+   PFN_vkGetPhysicalDeviceExternalBufferProperties get_external_props =
+      (PFN_vkGetPhysicalDeviceExternalBufferProperties)
+      screen->vk_GetInstanceProcAddr(screen->instance,
+                                    "vkGetPhysicalDeviceExternalBufferProperties");
+   int selected = -1;
+
+   if (!get_external_props)
+      return -1;
+
+   for (uint32_t i = 0; i < pdev_count; i++) {
+      VkPhysicalDeviceDriverProperties driver = {
+         .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_DRIVER_PROPERTIES,
+      };
+      VkPhysicalDeviceProperties2 props = {
+         .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2,
+         .pNext = &driver,
+      };
+      VKSCR(GetPhysicalDeviceProperties2)(pdevs[i], &props);
+      if (driver.driverID != VK_DRIVER_ID_MESA_TURNIP ||
+          props.properties.vendorID != 0x5143 ||
+          (props.properties.deviceID & 0xffffff00u) != 0x06050000u)
+         continue;
+
+      uint32_t count = 0;
+      if (VKSCR(EnumerateDeviceExtensionProperties)(pdevs[i], NULL, &count, NULL) != VK_SUCCESS ||
+          !count || count > 65536)
+         continue;
+      VkExtensionProperties *extensions = calloc(count, sizeof(*extensions));
+      if (!extensions)
+         return -1;
+      VkResult result = VKSCR(EnumerateDeviceExtensionProperties)(pdevs[i], NULL,
+                                                                &count, extensions);
+      bool has_drm = false, has_fd = false, has_dmabuf = false;
+      for (uint32_t j = 0; result == VK_SUCCESS && j < count; j++) {
+         has_drm |= !strcmp(extensions[j].extensionName,
+                            VK_EXT_PHYSICAL_DEVICE_DRM_EXTENSION_NAME);
+         has_fd |= !strcmp(extensions[j].extensionName,
+                           VK_KHR_EXTERNAL_MEMORY_FD_EXTENSION_NAME);
+         has_dmabuf |= !strcmp(extensions[j].extensionName,
+                               VK_EXT_EXTERNAL_MEMORY_DMA_BUF_EXTENSION_NAME);
+      }
+      free(extensions);
+      /* Turnip explicitly omits EXT_physical_device_drm for its KGSL backend. */
+      if (result != VK_SUCCESS || has_drm || !has_fd || !has_dmabuf)
+         continue;
+
+      VkPhysicalDeviceExternalBufferInfo info = {
+         .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_EXTERNAL_BUFFER_INFO,
+         .usage = VK_BUFFER_USAGE_TRANSFER_SRC_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+         .handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT,
+      };
+      VkExternalBufferProperties external = {
+         .sType = VK_STRUCTURE_TYPE_EXTERNAL_BUFFER_PROPERTIES,
+      };
+      get_external_props(pdevs[i], &info, &external);
+      const VkExternalMemoryFeatureFlags needed =
+         VK_EXTERNAL_MEMORY_FEATURE_IMPORTABLE_BIT | VK_EXTERNAL_MEMORY_FEATURE_EXPORTABLE_BIT;
+      if ((external.externalMemoryProperties.externalMemoryFeatures & needed) != needed ||
+          !(external.externalMemoryProperties.compatibleHandleTypes &
+            VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT))
+         continue;
+      if (selected != -1) {
+         mesa_loge("ZINK: ambiguous SM-T870 KGSL devices, refusing display bridge");
+         return -1;
+      }
+      selected = i;
+   }
+   if (selected == -1)
+      mesa_loge("ZINK: SM-T870 requires Turnip Adreno 650 KGSL with DMA-BUF import/export");
+   else
+      mesa_logi("ZINK: explicit SM-T870 KGSL GPU / msm_drm display bridge enabled");
+   return selected;
+}
