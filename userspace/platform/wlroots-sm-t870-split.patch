+// Require a real Qualcomm VIG (not a virtual smart plane) and the zpos
+// contract verified on this panel. Property IDs are discovered on every boot.
+static bool sm_t870_plane_valid(struct wlr_drm_backend *drm,
+		struct wlr_drm_plane *plane) {
+	const union wlr_drm_plane_props *p = &plane->props;
+	if (plane->type == DRM_PLANE_TYPE_CURSOR || p->capabilities == 0 ||
+			p->zpos == 0 || p->fb_id == 0 || p->crtc_id == 0 ||
+			p->src_x == 0 || p->src_y == 0 || p->src_w == 0 || p->src_h == 0 ||
+			p->crtc_x == 0 || p->crtc_y == 0 || p->crtc_w == 0 || p->crtc_h == 0) {
+		return false;
+	}
+	drmModePropertyRes *zpos = drmModeGetProperty(drm->fd, p->zpos);
+	bool zpos_ok = zpos != NULL && !(zpos->flags & DRM_MODE_PROP_IMMUTABLE) &&
+		(zpos->flags & DRM_MODE_PROP_RANGE) && zpos->count_values == 2 &&
+		zpos->values[0] == 0;
+	drmModeFreeProperty(zpos);
+	if (!zpos_ok) {
+		return false;
+	}
+	size_t len = 0;
+	char *blob = get_drm_prop_blob(drm->fd, plane->id, p->capabilities, &len);
+	if (blob == NULL || len == 0 || len > 65536) {
+		free(blob);
+		return false;
+	}
+	char *caps = strndup(blob, len);
+	free(blob);
+	bool valid = caps != NULL && strstr(caps, "scaler_step_ver=") != NULL &&
+		strstr(caps, "primary_smart_plane_id=") == NULL;
+	free(caps);
+	return valid;
+}
