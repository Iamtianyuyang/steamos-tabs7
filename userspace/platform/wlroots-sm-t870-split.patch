+static bool init_sm_t870_split(struct wlr_drm_backend *drm, drmModeRes *res) {
+	if (!drm->sm_t870_split) {
+		return true;
+	}
+	if (drm->num_crtcs > 32) {
+		return false;
+	}
+	struct wlr_drm_plane *pair[2] = {0};
+	uint32_t common = UINT32_MAX, reserved = 0;
+	for (size_t i = 0; i < 2; i++) {
+		for (size_t j = 0; j < drm->num_planes; j++) {
+			if (drm->planes[j].id == drm->sm_t870_plane_ids[i]) {
+				pair[i] = &drm->planes[j];
+				break;
+			}
+		}
+		if (pair[i] == NULL || !sm_t870_plane_valid(drm, pair[i])) {
+			wlr_log(WLR_ERROR, "SM-T870 plane %"PRIu32" is not a real VIG with writable zpos=0",
+				drm->sm_t870_plane_ids[i]);
+			return false;
+		}
+		drmModePlane *p = drmModeGetPlane(drm->fd, pair[i]->id);
+		if (p == NULL) {
+			return false;
+		}
+		common &= p->possible_crtcs;
+		// Existing live bindings must agree. Never move a plane from a live
+		// unrelated CRTC. A zero FB is not proof of logical availability.
+		if (p->crtc_id != 0) {
+			uint32_t bound = 0;
+			for (size_t j = 0; j < drm->num_crtcs; j++) {
+				if (drm->crtcs[j].id == p->crtc_id) {
+					bound = UINT32_C(1) << j;
+				}
+			}
+			common &= bound;
+		}
+		drmModeFreePlane(p);
+		for (size_t j = 0; j < drm->num_crtcs; j++) {
+			if (drm->crtcs[j].cursor == pair[i]) {
+				return false;
+			}
+			if (drm->crtcs[j].primary == pair[i]) {
+				reserved |= UINT32_C(1) << j;
+			}
+		}
+	}
+
+	// Restrict the pair to the actual DSI-1 encoder. Refuse other live
+	// connectors on the selected CRTC rather than stealing their planes.
+	uint32_t dsi_mask = 0, other_live = 0;
+	for (int i = 0; i < res->count_connectors; i++) {
+		drmModeConnector *c = drmModeGetConnector(drm->fd, res->connectors[i]);
+		if (c == NULL) {
+			return false;
+		}
+		bool dsi = c->connector_type == DRM_MODE_CONNECTOR_DSI &&
+			c->connector_type_id == 1 && c->connection == DRM_MODE_CONNECTED;
+		for (int j = 0; j < c->count_encoders; j++) {
+			drmModeEncoder *e = drmModeGetEncoder(drm->fd, c->encoders[j]);
+			if (e == NULL) {
+				drmModeFreeConnector(c);
+				return false;
+			}
+			if (dsi) {
+				dsi_mask |= e->possible_crtcs;
+			} else if (c->encoder_id == e->encoder_id && e->crtc_id != 0) {
+				for (size_t k = 0; k < drm->num_crtcs; k++) {
+					if (drm->crtcs[k].id == e->crtc_id) {
+						other_live |= UINT32_C(1) << k;
+					}
+				}
+			}
+			drmModeFreeEncoder(e);
+		}
+		drmModeFreeConnector(c);
+	}
+	common &= dsi_mask & ~other_live;
+	struct wlr_drm_crtc *target = NULL;
+	uint32_t target_mask = 0;
+	for (size_t i = 0; i < drm->num_crtcs; i++) {
+		uint32_t bit = UINT32_C(1) << i;
+		if ((common & bit) && drm->crtcs[i].primary != NULL) {
+			target = &drm->crtcs[i];
+			target_mask = bit;
+			break;
+		}
+	}
+	if (target == NULL || (reserved & other_live) != 0) {
+		wlr_log(WLR_ERROR, "SM-T870 VIG pair has no available common DSI-1 CRTC");
+		return false;
+	}
+	if (target->primary->initial_crtc_id != 0 &&
+			target->primary->initial_crtc_id != target->id) {
+		return false;
+	}
+	struct wlr_drm_format_set formats = {0};
+	if (!wlr_drm_format_set_intersect(&formats, &pair[0]->formats, &pair[1]->formats)) {
+		wlr_drm_format_set_finish(&formats);
+		wlr_log(WLR_ERROR, "SM-T870 VIG pair has no common formats");
+		return false;
+	}
+	drm->sm_t870_planes[0] = pair[0];
+	drm->sm_t870_planes[1] = pair[1];
+	drm->sm_t870_crtc = target;
+	drm->sm_t870_crtc_mask = target_mask;
+	drm->sm_t870_reserved_crtcs = reserved | target_mask;
+	drm->sm_t870_formats = formats;
+	wlr_log(WLR_INFO, "SM-T870 split: DSI-1, CRTC %"PRIu32", VIG planes %"PRIu32"/%"PRIu32,
+		target->id, pair[0]->id, pair[1]->id);
+	return true;
+}
