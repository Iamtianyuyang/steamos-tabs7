# Display path for the mainline 6.18 SteamOS kernel.
# Layered on top of gts7lwifi-bringup.config and steamos-6.18.config. This exists
# to compile and link the SM8250 DPU, the 7nm DSI PHY (C-PHY) and the NT36523
# panel driver; it does not mean the panel works. Keep the panel node disabled
# in the DTS until the profile in hardware/samsung/gts7lwifi/panel/ matches.

# DRM_MSM depends on these; allnoconfig turns them off.
CONFIG_DRM=y
CONFIG_COMMON_CLK=y
CONFIG_IOMMU_SUPPORT=y
CONFIG_GPIOLIB=y
CONFIG_QCOM_LLCC=y
CONFIG_QCOM_OCMEM=y
CONFIG_SM_DISPCC_8250=y
CONFIG_SM_GPUCC_8250=y
CONFIG_FW_LOADER=y

# SM8250 display: DPU + DSI + the 7nm (v4.0) PHY used by DSI0/DSI1.
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_DPU=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_DSI_7NM_PHY=y

# Panel: the SM-T870 NT36523 (C-PHY, dual-DSI video mode PPA957DB1 WQXGA).
CONFIG_DRM_PANEL_NOVATEK_NT36523_GTS7LWIFI=y

# Backlight for the panel's DCS brightness path.
CONFIG_BACKLIGHT_CLASS_DEVICE=y

# Touch half of the NT36523 TDDI; follows the panel power state.
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_NOVATEK_NVT_TS=y
