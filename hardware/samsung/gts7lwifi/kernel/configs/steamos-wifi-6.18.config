# Wi-Fi path for the mainline 6.18 SteamOS kernel, layered after
# steamos-audio-6.18.config: PCIe0 for the QCA6390 package, the pwrseq PMU
# driver that drives its enable line, and ath11k over PCI. See
# docs/steamos/wifi-6.18.md.
#
# This compiles and links the drivers only. The board firmware (amss.bin,
# m3.bin and the matching BDF) is not in the image yet, so ath11k probe is
# expected to fail with a firmware load error until that step is done.

# PCIe0: DesignWare host with the SM8250 glue, its PHY and the root port.
# The host defers until 1c06000.phy probes, and that PHY has its own driver:
# without PHY_QCOM_QMP_PCIE the link never trains and the boards just sit in
# deferred probe without an error.
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCIEPORTBUS=y
CONFIG_PCIE_QCOM=y
CONFIG_GENERIC_PHY=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_PCIE=y

# QCA6390 PMU power sequencing. PCI_PWRCTRL_PWRSEQ has no prompt, so it cannot
# be requested here; ATH11K_PCI selects it once HAVE_PWRCTRL is set, which
# PCIE_QCOM brings in through PCI_PWRCTRL_SLOT.
CONFIG_POWER_SEQUENCING=y
CONFIG_POWER_SEQUENCING_QCOM_WCN=y

# cfg80211/mac80211 with the regulatory database built in, then ath11k.
# net/wireless/Kconfig is only sourced under WIRELESS, and only WLAN selects
# that, so allnoconfig drops the whole stack without CONFIG_WLAN.
CONFIG_WLAN=y
# drivers/net/wireless/ath/Kconfig hides every Atheros/Qualcomm driver behind
# this menu switch, so ath11k is unreachable without it.
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_ATH11K=y
CONFIG_ATH11K_PCI=y

# NetworkManager drives the radio through /dev/rfkill.
CONFIG_RFKILL=y

# ath11k loads the board data through the firmware API at probe time.
CONFIG_FW_LOADER=y
