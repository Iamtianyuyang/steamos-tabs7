# Speaker path for the mainline 6.18 SteamOS kernel, layered after
# steamos-display-6.18.config: ADSP (remoteproc/glink/APR), the Q6 audio
# services, the SM8250 machine driver with Primary TDM, and the four CS35L41
# smart amplifiers on i2c11. See docs/steamos/audio-6.18.md.

# ADSP: PAS remoteproc with SMP2P/IPCC signalling and the glink-smem edge.
CONFIG_REMOTEPROC=y
CONFIG_QCOM_Q6V5_PAS=y
CONFIG_QCOM_SMP2P=y
CONFIG_RPMSG=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_QCOM_SYSMON=y

# QMI over QRTR for the in-kernel protection-domain mapper and sysmon; the
# ADSP's audio PD is located through it before APR services come up.
CONFIG_QRTR=y
CONFIG_QRTR_SMD=y
CONFIG_QCOM_PD_MAPPER=y

# Q6 audio over APR.
CONFIG_QCOM_APR=y

# ALSA/ASoC. SND_SOC_SM8250 depends on SOUNDWIRE even without a SoundWire
# master on this board.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
# /proc/asound: card enumeration for ALSA tools; allnoconfig leaves it off.
CONFIG_SND_PROC_FS=y
CONFIG_SOUNDWIRE=y
CONFIG_SND_SOC_QCOM=y
CONFIG_SND_SOC_SM8250=y
CONFIG_SND_SOC_CS35L41_I2C=y
