# SteamOS as the only system on the mainline 6.18 tree.
# Layered on top of gts7lwifi-bringup.config, which already provides the boot,
# USB gadget, configfs, pstore and log path. Build with
# scripts/build/mainline/build-steamos-6.18.sh; every line here is verified
# against the resulting .config, so a silently dropped option fails the build.

# The initramfs validates userdata and builds devtmpfs on /newroot itself, so
# the kernel must not mount one first (same decision as the vendor 4.19 variant).
# CONFIG_DEVTMPFS_MOUNT is not set

# systemd 257 as PID 1 (systemd README, "Kernel Config Options").
CONFIG_FHANDLE=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_AIO=y
CONFIG_IO_URING=y
CONFIG_INOTIFY_USER=y
CONFIG_FANOTIFY=y
CONFIG_IPV6=y
CONFIG_FILE_LOCKING=y
CONFIG_BINFMT_MISC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_BPF_SYSCALL=y
# allnoconfig leaves cgroups off; systemd units need the pids controller.
CONFIG_CGROUPS=y
CONFIG_CGROUP_PIDS=y
CONFIG_NAMESPACES=y
# bwrap/pressure-vessel for the Steam Linux Runtime and systemd PrivateUsers=.
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_UTS_NS=y
# steamos-log-submitter and steamos-manager create a tracefs instance.
CONFIG_TRACING=y
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
# IPC_NS stays off: the vendor 4.19 variant kept it off and the Steam Runtime
# has not been verified with it on this device. Flip it here once tested.
# CONFIG_IPC_NS is not set
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y

# Steam's native ARM64 client calls semget(); Android shipped System V IPC off.
CONFIG_SYSVIPC=y
CONFIG_SYSVIPC_SYSCTL=y
CONFIG_SYSVIPC_COMPAT=y

# Chromium/Steam's page allocator uses madvise; allnoconfig otherwise leaves
# the syscall returning ENOSYS and the UI renderer repeatedly aborts.
CONFIG_ADVISE_SYSCALLS=y

# The hand-over mounts the userdata partition (F2FS) before starting SteamOS;
# without this the SteamOS tree is unreachable from a mainline kernel.
CONFIG_F2FS_FS=y
# The on-device F2FS has the quota feature and rejects RW mounts without it.
CONFIG_QUOTA=y
# Enable GPT parsing. The rev7 6.18 boot exposes PARTNAME in uevent; other
# kernels may expose partlabel, and the initramfs accepts either.
CONFIG_EFI_PARTITION=y

# Driver modules are needed for peripheral bring-up and matching diagnostic probes.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODVERSIONS=y
CONFIG_BASIC_MODVERSIONS=y
