# SteamOS as the sole system: systemd PID 1 and the Steam Runtime container.
# Applied on top of steamos-ipc.config; every other option stays original.
# systemd hard requirements (systemd README, Kernel Config Options).
CONFIG_DEVTMPFS=y
CONFIG_FHANDLE=y
# cgroup pids controller used by systemd units.
CONFIG_CGROUP_PIDS=y
# bwrap/pressure-vessel (Steam Linux Runtime) and systemd PrivateUsers=.
CONFIG_USER_NS=y
CONFIG_PID_NS=y
# Strongly recommended by systemd (automount units).
CONFIG_AUTOFS_FS=y
