# Bluetooth path for the mainline 6.18 SteamOS kernel, layered after
# steamos-wifi-6.18.config: the QCA6390 BT half is a serdev device on uart6 and
# is driven by hci_qca. See docs/steamos/bluetooth-6.18.md.

# The UART-attached HCI transport needs the serial device bus; allnoconfig
# drops both and then the bluetooth node never binds.
CONFIG_TTY=y
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SERIAL_DEV_BUS=y
# Without the TTY-port controller serdev builds only the core: serial_core then
# registers a plain tty and never instantiates the DT child, so the bluetooth
# node is silently ignored (ttyHS0 appears, no hci0, no hci_qca probe).
CONFIG_SERIAL_DEV_CTRL_TTYPORT=y

# HCI core plus the Qualcomm protocol (H4 transport, IBS and the rampatch/NVM
# download that QCA6390 needs after power-on).
CONFIG_BT=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_QCA=y

# BlueZ on the SteamOS side speaks plain HCI; keep the socket transport too so
# btmon and the Steam client's pairing path have it.
CONFIG_BT_HCIVHCI=y

# These all default to y but carry a prompt, so allnoconfig turns them off and
# the result is subtle: pairing works (mgmt does it over HCI), but every profile
# connect fails with "Protocol not available", because sco.o is gated by
# BT_BREDR and A2DP/HFP need L2CAP over BR/EDR plus the SCO socket.
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_BNEP=y
CONFIG_BT_HIDP=y

# Input devices: classic BT HID needs BT_HIDP plus the HID core, and BlueZ
# exposes LE HID (HOGP) through uhid, i.e. CONFIG_UHID plus the same core.
# HID_SUPPORT is a menuconfig: without it HID, UHID and BT_HIDP are unreachable
# and allnoconfig silently drops every one of them.
CONFIG_INPUT=y
CONFIG_HID_SUPPORT=y
CONFIG_HID=y
CONFIG_UHID=y

# BlueZ asks the kernel crypto API for its identity-resolving key and other
# primitives ("generate_and_write_irk() Failed to open crypto" without AF_ALG),
# and the A2DP/AVDTP paths fail early with "Protocol not available" when the
# crypto-backed socket helpers are unavailable.
CONFIG_CRYPTO_USER_API=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_CMAC=y

# btmon and the HCI debugfs nodes.
CONFIG_BT_DEBUGFS=y
